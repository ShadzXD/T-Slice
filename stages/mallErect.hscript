var upperBoppers;
var bottomBoppers;
var santa;
var colorShader = Paths.getShader("adjustColor");
var colorShaderBopper = Paths.getShader("adjustColor");

function buildStage()
{
	var bg:BGSprite = new BGSprite('stages/mall-erect/walls', -500, -500, 0.2, 0.2);
	bg.scale.set(0.8, 0.8);
	bg.updateHitbox();
	add(bg);

	if(!ClientPrefs.lowQuality) {
		upperBoppers = new BGSprite('stages/mall-erect/boppers-upper', -410, -160, 0.33, 0.33, ['upperBop']);
		upperBoppers.scale.set(0.85, 0.85);
		upperBoppers.updateHitbox();
		add(upperBoppers);

		var bgEscalator:BGSprite = new BGSprite('stages/mall-erect/escalator', -1100, -600, 0.3, 0.3);
		bgEscalator.scale.set(0.9, 0.9);
		bgEscalator.updateHitbox();
		add(bgEscalator);
	}

	var tree:BGSprite = new BGSprite('stages/mall-erect/tree', 370, -250, 0.40, 0.40);
	add(tree);

	var fog:BGSprite = new BGSprite('stages/mall-erect/white', -1000, 300, 0.85, 0.85);
	add(fog);
	
	bottomBoppers = new FlxAnimate(-450, 120);
	bottomBoppers.frames = Paths.animateAtlas('stages/mall-erect/boppers-bottom');
	bottomBoppers.scrollFactor.set(0.9, 0.9);
	bottomBoppers.animation.addBySymbol('hey', 'BOPPERS_EXPORT', 24, false);
	bottomBoppers.scale.set(1.0, 1.0);
	bottomBoppers.updateHitbox();
	add(bottomBoppers);

	var snowUnder:FlxSprite = new FlxSprite(-1500, 800).makeGraphic(5700, 3000, '0xF3F4F5');
	add(snowUnder);

	var fgSnow:BGSprite = new BGSprite('stages/mall/fgSnow', -600, 700);
	add(fgSnow);

	santa = new BGSprite('stages/mall/santa', -840, 150, 1, 1, ['santa idle in fear']);
	foreground.add(santa);
}
function onCreatePost()
{
	if(ClientPrefs.shaders != 'None')
	{
		colorShader.setFloat("hue", 5);
		colorShader.setFloat("saturation", 5);
		//colorShader.setFloat("contrast", 0);
		game.boyfriend.shader = colorShader;
		game.gf.shader = colorShader;
		game.dad.shader = colorShader;
		santa.shader = colorShader;
		colorShaderBopper.setFloat("hue", 15);
		colorShaderBopper.setFloat("brightness", 20);
		bottomBoppers.shader = colorShaderBopper;
		//colorShader.setFloat("saturation", -16);
	}
}
function danceBoppers()
{
	if(!ClientPrefs.lowQuality)
		upperBoppers.dance(true);

	bottomBoppers.anim.play('hey', true);
	santa.dance(true);
}

script.set("onCountdownTick", danceBoppers);
script.set("onBeatHit", danceBoppers);