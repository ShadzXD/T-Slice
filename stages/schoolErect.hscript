function onCreatePost()
{

   // rim.setAdjustColor(-66, -10, 24, -23);
	shadowShader.setFloat("hue", -10);
	shadowShader.setFloat("saturation", -23);
	shadowShader.setFloat("contrast", 24);
	shadowShader.setFloat("brightness", -66);
	shadowShader.setFloat("str", 1);
	shadowShader.setFloat("ang", 90);
	shadowShader.setFloat("dist", 5);
	shadowShader.setFloat("thr", 0.1);

	game.boyfriend.shader = shadowShader;
	game.gf.shader = shadowShader;
	game.dad.shader = shadowShader;
    //rim.color = 0xFF52351d;
    //rim.attachedSprite = character;
   // rim.distance = 5;
}

