var colorShaderBf = Paths.getShader("adjustColor");
var colorShaderDad = Paths.getShader("adjustColor");
var colorShaderGf = Paths.getShader("adjustColor");

function onLoad(stage, foreground)
{
	var backDark:BGSprite = new BGSprite('stages/stage-erect/backDark', 729, -170, 1, 1);
	add(backDark);
	
	var brightLightSmall:BGSprite = new BGSprite('stages/stage-erect/brightLightSmall', 967, -103, 1, 1);
	add(brightLightSmall);
	
	var crowd = new FlxSprite(560, 290);
	crowd.scrollFactor.set(0.8, 0.8);
	crowd.frames = Paths.getSparrowAtlas('stages/stage-erect/crowd');
	crowd.animation.addByPrefix('idle', "Symbol 2 instance 1", 12);
	crowd.animation.play('idle');
	add(crowd);

	var bg:BGSprite = new BGSprite('stages/stage-erect/bg', -603, -187, 1, 1);
	add(bg);

	var server:BGSprite = new BGSprite('stages/stage-erect/server', -361, 205, 1, 1);
	add(server);

	var lights:BGSprite = new BGSprite('stages/stage-erect/lights', -601, -147, 1.2, 1.2);
	foreground.add(lights);

	var orangeLight:BGSprite = new BGSprite('stages/stage-erect/orangeLight', 189, -195, 1, 1);
	orangeLight.blend = 0;
	foreground.add(orangeLight);

	var lightgreen:BGSprite = new BGSprite('stages/stage-erect/lightgreen', -171, 242, 1, 1);
	lightgreen.blend = 0;
	foreground.add(lightgreen);

	var lightred:BGSprite = new BGSprite('stages/stage-erect/lightred', -101, 560, 1, 1);
	lightred.blend = 0;
	add(lightred);

	var lightAbove:BGSprite = new BGSprite('stages/stage-erect/lightAbove', 804, -117, 1, 1);
	lightAbove.blend = 0;
	foreground.add(lightAbove);

	if(ClientPrefs.shaders != 'None')
	{
		colorShaderBf.setFloat("brightness", -23);
		colorShaderBf.setFloat("hue", 12);
		colorShaderBf.setFloat("contrast", 7);
		colorShaderBf.setFloat("saturation", 0);

		colorShaderGf.setFloat("brightness", -23);
		colorShaderGf.setFloat("hue", 12);
		colorShaderGf.setFloat("contrast", 7);
		colorShaderGf.setFloat("saturation", 0);

		colorShaderDad.setFloat("brightness", -33);
		colorShaderDad.setFloat("hue", -32);
		colorShaderDad.setFloat("contrast", -23);
		colorShaderDad.setFloat("saturation", 0);

		game.boyfriend.shader = colorShaderBf;
		game.gf.shader = colorShaderGf;
		game.dad.shader = colorShaderDad;
	}
}

function onCreatePost()
{
	if(ClientPrefs.shaders == 'None')
	{
		game.dad.color = 0xFFD5D5D3;
		game.boyfriend.color = 0xFFC7C5C9;
		game.gf.color = 0xFFEFBFDA;
	}
}