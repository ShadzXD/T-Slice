//code by manofsomething
function onLoad(stage, foreground)
{
	var backDark:BGSprite = new BGSprite('stage-erect/backDark', 729, -170, 1, 1);
	add(backDark);
	
	var brightLightSmall:BGSprite = new BGSprite('stage-erect/brightLightSmall', 967, -103, 1, 1);
	add(brightLightSmall);
	
	var crowd = new FlxSprite(560, 290);
	crowd.scrollFactor.set(0.8, 0.8);
	crowd.frames = Paths.getSparrowAtlas('stage-erect/crowd');
	crowd.animation.addByPrefix('idle', "Symbol 2 instance 1", 12);
	crowd.animation.play('idle');
	add(crowd);

	var bg:BGSprite = new BGSprite('stage-erect/bg', -603, -187, 1, 1);
	add(bg);

	var server:BGSprite = new BGSprite('stage-erect/server', -361, 205, 1, 1);
	add(server);

	var lights:BGSprite = new BGSprite('stage-erect/lights', -601, -147, 1.2, 1.2);
	foreground.add(lights);

	var orangeLight:BGSprite = new BGSprite('stage-erect/orangeLight', 189, -195, 1, 1);
	orangeLight.blend = 0;
	foreground.add(orangeLight);

	var lightgreen:BGSprite = new BGSprite('stage-erect/lightgreen', -171, 242, 1, 1);
	lightgreen.blend = 0;
	foreground.add(lightgreen);

	var lightred:BGSprite = new BGSprite('stage-erect/lightred', -101, 560, 1, 1);
	lightred.blend = 0;
	add(lightred);

	var lightAbove:BGSprite = new BGSprite('stage-erect/lightAbove', 804, -117, 1, 1);
	lightAbove.blend = 0;
	foreground.add(lightAbove);
}

function onCreatePost()
{
	game.dad.color = 0xFFD5D5D3;
	game.boyfriend.color = 0xFFC7C5C9;
	game.gf.color = 0xFFEFBFDA;
}